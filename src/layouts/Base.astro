---
import '../styles/global.css';
import { profile, social } from '../config';
import { pathFor, ui, type Locale, type Page } from '../i18n';
import { publishedPosts } from '../lib/content';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  page?: Page;
  alternate?: string | null;
  noindex?: boolean;
  article?: boolean;
  mainClass?: string;
}
const { lang, title, description, page = 'home', alternate, noindex = false, article = false, mainClass } = Astro.props;
const t = ui[lang];
const other = lang === 'en' ? 'es' : 'en';
const alternatePath = alternate === null ? undefined : alternate ?? (!article ? pathFor(other, page) : undefined);
const posts = await publishedPosts();
const hasBlog = posts.length > 0;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const alternateUrl = alternatePath && canonical && Astro.site ? new URL(alternatePath, Astro.site).href : undefined;
const navigation: Page[] = ['home', 'research', ...(hasBlog ? ['blog' as const] : [])];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === profile.name ? title : `${title} — ${profile.name}`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fcfcfa" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <link rel="alternate" hreflang={lang} href={canonical} />}
    {alternateUrl && <link rel="alternate" hreflang={other} href={alternateUrl} />}
    <meta name="robots" content={noindex || !Astro.site ? 'noindex, nofollow' : 'index, follow'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'es_ES'} />
    {canonical && <meta property="og:url" content={canonical} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href={pathFor(lang, 'home')} aria-label={`${profile.name} — ${t.home}`}>ahm<span aria-hidden="true">.</span></a>
        <nav class="primary-nav" aria-label={t.navigation}>
          {navigation.map(item => <a href={pathFor(lang, item)} aria-current={(page === item || ((page === 'thesis' || page === 'bachelorThesis') && item === 'research')) ? 'page' : undefined}>{t[item]}</a>)}
        </nav>
        {alternatePath && <nav class="language-nav" aria-label={t.language}>
          <a href={lang === 'en' ? Astro.url.pathname : alternatePath} lang="en" hreflang="en" aria-label="English" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
          <span aria-hidden="true">/</span>
          <a href={lang === 'es' ? Astro.url.pathname : alternatePath} lang="es" hreflang="es" aria-label="Español" aria-current={lang === 'es' ? 'page' : undefined}>ES</a>
        </nav>}
      </header>
      <main id="main" class={mainClass} tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <div><span class="footer-name">{profile.name}</span><p>{t.footer}</p></div>
        <nav aria-label={t.contact}>
          {profile.email && <details class="email-contact">
            <summary>Email</summary>
            <div class="email-panel">
              <p class="email-address" translate="no">{profile.email}</p>
              <p>{lang === 'en' ? 'Copy the address, or' : 'Copia la dirección o'}</p>
              <a href={`mailto:${profile.email}`}>{lang === 'en' ? 'open your email app' : 'abre tu aplicación de correo'} <span aria-hidden="true">↗</span></a>
            </div>
          </details>}
          {profile.cv && <a href={profile.cv}>{t.cv}</a>}
          {social.map(link => <a href={link.href}>{link.label}</a>)}
        </nav>
      </footer>
    </div>
  </body>
</html>
