---
import { pathFor, ui, type Locale } from '../i18n';
import { researchContent } from '../lib/content';
interface Props { lang: Locale; level?: 2 | 3; work?: 'thesis' | 'bachelorThesis' }
const { lang, level = 3, work = 'thesis' } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
const t = ui[lang];
const { data } = await researchContent(lang, work === 'thesis' ? 'predig' : 'dental-bone-loss');
---
<article class="research-entry">
  <p class="entry-meta">{t[work]}<span aria-hidden="true"> · </span>{data.institution} · {data.year}</p>
  <Heading class="entry-title" lang={data.titleLang}><a href={pathFor(lang, work)}>{data.title}</a></Heading>
  {data.subtitle && <p class="entry-subtitle" lang="en">{data.subtitle}</p>}
  <p class="entry-summary">{data.description}</p>
  <a class="text-link" href={pathFor(lang, work)}>{t.read} <span aria-hidden="true">→</span></a>
</article>
