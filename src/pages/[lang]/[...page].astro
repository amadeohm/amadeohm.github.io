---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ResearchEntry from '../../components/ResearchEntry.astro';
import BachelorFigures from '../../components/BachelorFigures.astro';
import genuPreview from '../../assets/blog/genu-2026/maike-osborne-talk.jpeg';
import posterPreview from '../../assets/blog/genu-2026/predig-poster.png';
import { locales, pathFor, ui, type Locale, type Page } from '../../i18n';
import { publishedPosts, researchContent } from '../../lib/content';

export function getStaticPaths() {
  return locales.flatMap(lang => (['research', 'thesis', 'bachelorThesis', 'blog'] as const).map(page => ({
    params: { lang, page: pathFor(lang, page).split('/').slice(2, -1).join('/') },
    props: { lang, page },
  })));
}
interface Props { lang: Locale; page: Exclude<Page, 'home'> }
const { lang, page } = Astro.props;
const t = ui[lang];
const allPosts = await publishedPosts();
const posts = allPosts.filter(post =>
  post.data.lang === lang ||
  !allPosts.some(candidate => candidate.data.lang === lang && candidate.data.translationKey === post.data.translationKey)
);
const thesisEntry = page === 'thesis' || page === 'bachelorThesis'
  ? await researchContent(lang, page === 'thesis' ? 'predig' : 'dental-bone-loss')
  : undefined;
const data = thesisEntry?.data;
const thesisRender = thesisEntry ? await render(thesisEntry) : undefined;
const Content = thesisRender?.Content;
const title = data?.title ?? t[page];
const description = data?.pageDescription ?? data?.description ?? (page === 'research' ? t.researchIntro : t.blogIntro);
---
<Base lang={lang} title={title} description={description} page={page} noindex={page === 'blog' && posts.length === 0}>
  {page === 'research' && <>
    <header class="page-heading"><p class="eyebrow">{lang === 'en' ? 'Questions, methods, and findings' : 'Preguntas, métodos y resultados'}</p><h1>{t.research}</h1></header>
    <div class="reading-column">
      <p class="page-intro">{t.researchIntro}</p>
      <section class="research-list" aria-label={t.research}>
        <ResearchEntry lang={lang} level={2} />
        <ResearchEntry lang={lang} level={2} work="bachelorThesis" />
      </section>
    </div>
  </>}
  {data && <article class="thesis-page">
    <a class="back-link" href={pathFor(lang, 'research')}><span aria-hidden="true">←</span> {t.backResearch}</a>
    <header class="page-heading thesis-heading">
      <p class="eyebrow">{t[page]} · {data.year}</p>
      <h1 lang={data.titleLang}>{title}</h1>
      {data.subtitle && <p class="thesis-subtitle" lang="en">{data.subtitle}</p>}
    </header>
    <dl class="thesis-meta">
      <div><dt>{t.author}</dt><dd>{data.author}</dd></div>
      <div><dt>{t.supervision}</dt><dd>{data.supervisorUrl ? <a href={data.supervisorUrl}>{data.supervisor}</a> : data.supervisor}</dd></div>
      <div><dt>{t.programme}</dt><dd>{data.programme}<br />{data.institution}</dd></div>
    </dl>
    {(data.pdf || data.code) && <div class="document-links">
      {data.pdf && <a href={data.pdf}>{t.thesisPdf}</a>}
      {data.code && <a href={data.code}>{t.code}</a>}
    </div>}
    {page === 'bachelorThesis' && <BachelorFigures lang={lang} />}
    <div class="reading-column prose thesis-prose">{Content && <Content />}</div>
  </article>}
  {page === 'blog' && <>
    <header class="page-heading"><h1>{t.blog}</h1><p class="page-intro">{t.blogIntro}</p></header>
    <div class="reading-column">
      {posts.length === 0 ? <p class="quiet-note">{t.blogEmpty}</p> : <ul class="post-list">
        {posts.map(post => {
          const href = `/${post.data.lang}/blog/${post.data.slug}/`;
          const isPoster = post.data.translationKey === 'predig-genu-2026';
          const hasPreview = post.data.translationKey === 'genu-2026-copenhagen' || isPoster;
          return <li class:list={{ 'has-preview': hasPreview, 'has-poster-preview': isPoster }}>
            {hasPreview && <a class="post-preview" href={href} tabindex="-1" aria-hidden="true">
              <Image src={isPoster ? posterPreview : genuPreview} width={420} widths={[210, 420]} sizes={isPoster ? '140px' : '(max-width: 700px) 100vw, 190px'} alt="" loading="lazy" decoding="async" format="webp" />
            </a>}
            <div class="post-summary" lang={post.data.lang}>
              <div class="post-meta">
                <time datetime={post.data.published.toISOString().slice(0, 10)}>{post.data.dateLabel ?? post.data.published.toLocaleDateString(post.data.lang === 'es' ? 'es-ES' : 'en-GB', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
                {post.data.lang !== lang && <span lang={lang}>{lang === 'es' ? 'En inglés' : 'In Spanish'}</span>}
              </div>
              <h2><a href={href}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
            </div>
          </li>;
        })}
      </ul>}
    </div>
  </>}
</Base>
